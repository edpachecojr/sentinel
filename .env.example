# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sentinel"
PRISMA_LOG_QUERIES="0"

# App URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_COOKIE_NAME="better-auth.session_token"
BETTER_AUTH_COOKIE_PREFIX="sentinel"

# OAuth Providers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (Mailtrap)
MAILTRAP_HOST="sandbox.smtp.mailtrap.io"
MAILTRAP_PORT="2525"
MAILTRAP_USER=""
MAILTRAP_PASS=""
MAILTRAP_FROM="noreply@sentinel.com"
